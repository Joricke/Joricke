# Research Chat System — Environment Configuration
# Copy this file to .env and fill in your values.

# --- LLM Provider ---
# Options: "openai" or "anthropic"
LLM_PROVIDER=anthropic

# --- API Keys (provide the one matching your provider) ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --- Model Selection ---
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# --- LLM Parameters ---
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=1024

# --- Database ---
# SQLite (default, good for single-user / development)
DATABASE_URL=sqlite:///./data/research_chat.db
# PostgreSQL (recommended for production / multi-user)
# DATABASE_URL=postgresql://username:password@localhost:5432/research_chat

# --- Server ---
HOST=0.0.0.0
PORT=8000

# --- Consent Notice ---
# Displayed to students before they start chatting
# CONSENT_NOTICE=This chat is part of a research study...
